# Copy to .env (never commit .env). Server-side only; nothing here reaches the browser.
# off | foundry | mock_for_tests (tests only - never presented as real inference)
BYLINE_AI_PROVIDER=off
# Microsoft Foundry OpenAI-compatible v1 endpoint + deployment name
FOUNDRY_OPENAI_BASE_URL=https://<your-resource>.services.ai.azure.com/openai/v1
FOUNDRY_DEPLOYMENT=gpt-4.1-mini
# entra (DefaultAzureCredential, recommended) | api_key
FOUNDRY_AUTH=entra
FOUNDRY_TOKEN_SCOPE=https://ai.azure.com/.default
# Optional: pin the tenant that owns the Foundry resource
FOUNDRY_TENANT_ID=
# Only for FOUNDRY_AUTH=api_key
FOUNDRY_API_KEY=
# Spend guards (hard cap is persistent across restarts: apps/api/.cache/model_call_ledger.json)
BYLINE_MODEL_CALL_CAP=20
BYLINE_MAX_MODEL_CALLS_PER_SESSION=30
BYLINE_MAX_MODEL_CALLS_GLOBAL_PER_DAY=400
BYLINE_MAX_TOKENS_PER_CASE=14000
BYLINE_MODEL_CONCURRENCY=2
# true = serve only recorded/cached real Foundry results, never start new model calls (safe public demo)
BYLINE_AI_CACHE_ONLY=false
